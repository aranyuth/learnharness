# LearnHarness Environment Variables Template
# Copy this file to .env.local if you wish to provide API keys via environment variables,
# or simply enter your API keys directly into the app's Settings UI (BYOK).

# OpenRouter API Key (required for LLM calls if using OpenRouter)
OPENROUTER_API_KEY=

# Optional: Google Custom Search for researcher agent's web_search tool
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# Optional: Deepgram for voice dictation
DEEPGRAM_API_KEY=

# Optional: Custom Chrome executable path for web demo testing
CHROME_PATH=
